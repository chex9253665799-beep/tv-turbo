<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CleanActivity" android:exported="false" />
        <activity android:name=".AppsActivity" android:exported="false" />
        <activity android:name=".SpeedActivity" android:exported="false" />
        <activity android:name=".AutoActivity" android:exported="false" />
        <activity android:name=".DiagActivity" android:exported="false" />
        <activity android:name=".InstallActivity" android:exported="false" />
    </application>
</manifest>
