<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="0" android:startColor="#126BCC" android:endColor="#7445DA"/><stroke android:width="2dp" android:color="#70E4FF"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="0" android:startColor="#2B69D9" android:endColor="#874DE9"/><corners android:radius="16dp"/></shape>
    </item>
    <item>
        <shape><gradient android:angle="0" android:startColor="#1A2A51" android:endColor="#2B2056"/><stroke android:width="1dp" android:color="#475889"/><corners android:radius="16dp"/></shape>
    </item>
</selector>
