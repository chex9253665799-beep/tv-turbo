<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="0" android:startColor="#2E6BFF" android:endColor="#7B4DFF" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="0" android:startColor="#2E6BFF" android:endColor="#7B4DFF" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#161C28" /><stroke android:width="1dp" android:color="#2A3245" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
