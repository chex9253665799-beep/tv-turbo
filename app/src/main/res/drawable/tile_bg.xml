<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="#243D83" android:endColor="#49368A"/>
            <stroke android:width="3dp" android:color="#59DFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#274B9E" android:endColor="#7045BF"/>
            <stroke android:width="2dp" android:color="#B9A6FF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#182A50" android:endColor="#281F53"/>
            <stroke android:width="1dp" android:color="#425687"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</selector>
