<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#1F2840" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#26304C" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#CC161C28" /><stroke android:width="1dp" android:color="#2A3245" /><corners android:radius="20dp" /></shape>
    </item>
</selector>
